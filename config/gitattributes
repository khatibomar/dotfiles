# ======================
# Go Specific Configurations
# ======================
*.go text eol=lf diff=go
go.mod merge=ours
go.sum merge=ours
**/vendor/** linguist-vendored
# Compiled test binaries
*.test binary
testdata/** linguist-generated

# ======================
# Source Control Essentials
# ======================
* text=auto

# Shell scripts (LF required)
*.sh text eol=lf
scripts/**/*.sh text eol=lf

# Never modify line endings for these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.gz binary
*.zip binary
*.tar binary
*.exe binary

# ======================
# Configuration Files
# ======================
.env text
.env.* text
*.toml text
*.yaml text
*.yml text
*.json text
Dockerfile text eol=lf
Makefile text eol=lf

# ======================
# Merge Strategies
# ======================
# Prevent conflicts in lock files
*.lock merge=ours
*.mod merge=ours
*.sum merge=ours

# Union merge for non-critical files
*.md merge=union
*.txt merge=union
CHANGELOG merge=union

# ======================
# Diff Configuration
# ======================
*.proto diff=proto
*.sql diff=sql
*.log diff=none
# Generated protobuf files
*.pb.go diff=off

# Custom diff drivers (xfuncname regexes live in config/gitconfig)

# ======================
# GitHub Linguist Overrides
# ======================
assets/** linguist-vendored
third_party/** linguist-vendored
**/mocks/** linguist-generated
**/testdata/** linguist-generated
# Generated string methods
**/*_string.go linguist-generated
# Kubernetes-style generated code
**/zz_generated*.go linguist-generated

# ======================
# Git LFS Configuration
# ======================
# Uncomment if using large files
# *.zip filter=lfs diff=lfs merge=lfs -text
# *.tar.gz filter=lfs diff=lfs merge=lfs -text
