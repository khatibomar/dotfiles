#!/bin/bash

# Auto-capitalize the subject line's first letter instead of rejecting the
# commit. Conventional Commit prefixes (e.g. "feat:", "fix(scope)!:") are
# stripped first, so the capitalization applies to the first non-whitespace
# character after the prefix, if any prefix exists.

COMMIT_MSG_FILE="$1"

awk '
  !skipped_prefix_search && !found && $0 !~ /^#/ && $0 ~ /[^[:space:]]/ {
    found = 1
    ln = NR
  }
  { lines[NR] = $0 }
  END {
    if (found) {
      line = lines[ln]

      # Strip a leading Conventional Commit prefix like "feat(scope)!: ".
      if (match(line, /^[a-zA-Z]+(\([^)]*\))?!?:[[:space:]]*/)) {
        prefix = substr(line, RSTART, RLENGTH)
        rest = substr(line, RSTART + RLENGTH)
      } else {
        prefix = ""
        rest = line
      }

      # Capitalize the first non-whitespace character of what remains.
      if (match(rest, /[^[:space:]]/)) {
        pos = RSTART
        c = substr(rest, pos, 1)
        if (c ~ /[a-z]/) {
          rest = substr(rest, 1, pos - 1) toupper(c) substr(rest, pos + 1)
        }
      }

      lines[ln] = prefix rest
    }

    for (i = 1; i <= NR; i++) print lines[i]
  }
' "$COMMIT_MSG_FILE" > "$COMMIT_MSG_FILE.tmp" && mv "$COMMIT_MSG_FILE.tmp" "$COMMIT_MSG_FILE"
