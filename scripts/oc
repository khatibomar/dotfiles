#!/usr/bin/env bash
# oc: run one OpenCode executor task, watch it for hangs, print a short report.
#
#   oc [options] "prompt"          start a task (prompt can also come from stdin)
#   oc -s ses_xxx "feedback"       send a task back for revision in the same session
#   oc ps                          list runs that are still active
#   oc wait [run-name...]          wait for runs, then print their reports (no names: all active)
#   oc kill <run-name>             stop a run
#   oc log <run-name>              print the full report of a run
#   oc top                         open the run dashboard (oc-top)
#
# Options:
#   -m model     model (default $OC_MODEL or opencode-go/deepseek-v4.1-flash)
#   -s session   continue this OpenCode session
#   -n name      short run name (default: task)
#   -f file      attach a file (repeatable)
#   -w [name]    run in a new git worktree
#   -i seconds   idle limit before the run counts as hung (default 300)
#   -t seconds   hard time limit (default 2400)
#   -c seconds   checkpoint: stop with state slow after this time so the reviewer can help (default 300, 0 = off)
#   -r           read-only task: add "Do not edit any files" to the prompt
#   -q           quiet: print one summary line, not the full report
#
# Exit codes: 0 done, 1 failed, 2 blocked, 3 hung, 4 timeout, 5 usage limit, 6 slow (checkpoint).
set -uo pipefail

# Braces make bash parse the whole file before it runs, so edits do not break active runs.
{

OC_MODEL="${OC_MODEL:-opencode-go/deepseek-v4.1-flash}"
OC_FALLBACK="${OC_FALLBACK:-opencode-go/crouton-alpha-free}"
OC_RUNS="${OC_RUNS:-$HOME/.local/state/oc}"
OC_SVC_LOG="${OC_SVC_LOG:-$HOME/.local/share/opencode/log/opencode.log}"
REPORT_LINES="${OC_REPORT_LINES:-80}"

mkdir -p "$OC_RUNS"

run_parent() { jq -r '.parent // ""' "$1/meta.json" 2>/dev/null; }

run_active() {
  [[ -f "$1/pid" ]] || return 1
  local p; p=$(<"$1/pid")
  [[ -n $p ]] && kill -0 "$p" 2>/dev/null
}

hit_usage_limit() {
  jq -e -s 'any(.[]; (.type != "tool_use" and .type != "text") and (tostring | test("provider.go-limit|GoUsageLimitError")))' "$1" >/dev/null 2>&1
}

cmd_ps() {
  local d any=0 parent_of
  ps_line() {
    local dir=$1 level=$2 prefix="" pid idle last nm c
    (( level > 0 )) && prefix=$(printf '%*s└ ' $(( 4 * level - 2 )) "")
    nm=$(basename "$dir")
    pid=$(<"$dir/pid")
    idle=$(( $(date +%s) - $(stat -c %Y "$dir/events.jsonl" 2>/dev/null || date +%s) ))
    last=$(jq -r 'select(.type=="tool_use") | .part.tool' "$dir/events.jsonl" 2>/dev/null | tail -1)
    printf '%s%s  pid=%s  idle=%ss  last_tool=%s\n' "$prefix" "$nm" "$pid" "$idle" "${last:--}"
    any=1
    for c in "$OC_RUNS"/*/; do
      [[ -f "$c/meta.json" ]] || continue
      [[ "$(run_parent "${c%/}")" == "$nm" ]] || continue
      run_active "${c%/}" && ps_line "${c%/}" $(( level + 1 ))
    done
  }
  for d in "$OC_RUNS"/*/; do
    run_active "${d%/}" || continue
    [[ -f "$d/meta.json" ]] || continue
    parent_of=$(run_parent "${d%/}")
    if [[ -z $parent_of ]] || ! run_active "$OC_RUNS/$parent_of"; then
      ps_line "${d%/}" 0
    fi
  done
  (( any )) || echo "no active runs"
}

cmd_kill() {
  local d="$OC_RUNS/$1" ocpid=""
  [[ -d "$d" ]] || { echo "no run $1" >&2; exit 1; }
  # pid is the opencode child; oc.pid is the watchdog, which stops the children on TERM.
  [[ -f "$d/oc.pid" ]] && ocpid=$(<"$d/oc.pid")
  if [[ -n $ocpid ]] && kill -0 "$ocpid" 2>/dev/null; then
    kill "$ocpid" 2>/dev/null && echo "killed $1"
    return
  fi
  [[ -f "$d/pid" ]] || { echo "no run $1" >&2; exit 1; }
  kill "$(<"$d/pid")" 2>/dev/null && echo "killed $1"
}

run_alive() {
  local d=$1 p f
  for f in oc.pid pid; do
    [[ -f "$d/$f" ]] || continue
    p=$(<"$d/$f")
    [[ -n $p ]] && kill -0 "$p" 2>/dev/null && return 0
  done
  return 1
}

cmd_wait() {
  local -a runs=("$@")
  local d r
  if ((${#runs[@]} == 0)); then
    for _ in 1 2 3 4 5; do
      for d in "$OC_RUNS"/*/; do
        [[ -f "$d/meta.json" ]] || continue
        run_alive "${d%/}" && runs+=("$(basename "${d%/}")")
      done
      ((${#runs[@]})) && break
      sleep 1
    done
  fi
  if ((${#runs[@]} == 0)); then
    echo "no active runs"
    return 0
  fi
  echo "waiting for ${#runs[@]} run(s)"
  for r in "${runs[@]}"; do
    d="$OC_RUNS/$r"
    if [[ ! -d "$d" ]]; then
      echo "no run $r" >&2
      continue
    fi
    while [[ ! -f "$d/result.json" ]] && run_alive "$d"; do
      sleep 2
    done
    for _ in 1 2 3 4 5; do
      [[ -f "$d/result.json" ]] && break
      sleep 1
    done
    if [[ -f "$d/report.md" ]]; then
      cat "$d/report.md"
    else
      echo "no report for $r" >&2
    fi
    echo
  done
}

count_live_children() {
  local par=$1 d p n=0
  for d in "$OC_RUNS"/*/; do
    [[ -f "$d/meta.json" && -f "$d/pid" ]] || continue
    [[ "$(run_parent "${d%/}")" == "$par" ]] || continue
    p=$(<"$d/pid")
    [[ -n $p ]] && kill -0 "$p" 2>/dev/null && n=$((n + 1))
  done
  echo "$n"
}

case "${1:-}" in
  ps) cmd_ps; exit 0 ;;
  wait) shift; cmd_wait "$@"; exit $? ;;
  kill) cmd_kill "${2:?run name}"; exit 0 ;;
  log) cat "$OC_RUNS/${2:?run name}/report.md"; exit 0 ;;
  top) shift; exec oc-top "$@" ;;
esac

model="$OC_MODEL" session="" name="task" idle_limit=300 hard_limit=2400 checkpoint=300 readonly=0 quiet=0
files=() worktree=()
while getopts ":m:s:n:f:w:i:t:c:rq" opt; do
  case $opt in
    m) model=$OPTARG ;;
    s) session=$OPTARG ;;
    n) name=$OPTARG ;;
    f) files+=(-f "$OPTARG") ;;
    w) worktree=(--worktree="$OPTARG") ;;
    i) idle_limit=$OPTARG ;;
    t) hard_limit=$OPTARG ;;
    c) checkpoint=$OPTARG ;;
    r) readonly=1 ;;
    q) quiet=1 ;;
    :) [[ $OPTARG == w ]] && worktree=(--worktree) || { echo "-$OPTARG needs a value" >&2; exit 64; } ;;
    *) echo "unknown option -$OPTARG" >&2; exit 64 ;;
  esac
done
shift $((OPTIND - 1))
[[ ${OC_READONLY:-0} == 1 ]] && readonly=1

# Child-run contract: the environment names the parent run and this run's depth.
parent="${OC_PARENT:-}"
depth="${OC_DEPTH:-0}"
max_depth="${OC_MAX_DEPTH:-4}"
[[ $depth =~ ^[0-9]+$ ]] || depth=0
[[ $max_depth =~ ^[0-9]+$ ]] || max_depth=4

if (( depth >= max_depth )); then
  echo "oc: child runs not allowed for this task (depth $depth, max $max_depth)" >&2
  exit 2
fi

task="$*"
[[ -z "$task" && ! -t 0 ]] && task=$(cat)
[[ -z "$task" ]] && { echo "no prompt" >&2; exit 64; }

run="$name-$(date +%Y%m%d-%H%M%S)-$$"
dir="$OC_RUNS/$run"
mkdir -p "$dir"
wt=""; ((${#worktree[@]})) && wt="${worktree[0]#--worktree=}"
ro_bool=false; (( readonly )) && ro_bool=true
jq -n --arg run "$run" --arg name "$name" --arg cwd "$PWD" --arg model "$model" --arg worktree "$wt" --arg session "$session" --arg parent "$parent" --argjson depth "$depth" --argjson readonly "$ro_bool" --argjson idle_limit "$idle_limit" --argjson hard_limit "$hard_limit" --argjson checkpoint "$checkpoint" --argjson started "$(date +%s)" '{run:$run, name:$name, cwd:$cwd, model:$model, readonly:$readonly, worktree:$worktree, session:$session, idle_limit:$idle_limit, hard_limit:$hard_limit, checkpoint:$checkpoint, started:$started, parent:$parent, depth:$depth}' > "$dir/meta.json"
echo $$ > "$dir/oc.pid"

child_dirs() {
  local d
  for d in "$OC_RUNS"/*/; do
    [[ -f "$d/meta.json" ]] || continue
    [[ "$(run_parent "${d%/}")" == "$run" ]] && printf '%s\n' "${d%/}"
  done
}

live_children() {
  local d p
  while read -r d; do
    [[ -n $d ]] || continue
    [[ -f "$d/pid" ]] || continue
    p=$(<"$d/pid")
    [[ -n $p ]] && kill -0 "$p" 2>/dev/null && printf '%s\n' "$d"
  done < <(child_dirs)
}

child_usage_limit() {
  local d
  while read -r d; do
    [[ -n $d && -f "$d/result.json" ]] || continue
    [[ "$(jq -r '.state // ""' "$d/result.json" 2>/dev/null)" == usage-limit ]] && return 0
  done < <(child_dirs)
  return 1
}

kill_children() {
  local d p o
  while read -r d; do
    [[ -n $d ]] || continue
    o=""
    [[ -f "$d/oc.pid" ]] && o=$(<"$d/oc.pid")
    if [[ -n $o ]] && kill -0 "$o" 2>/dev/null; then
      kill "$o" 2>/dev/null
    else
      p=$(<"$d/pid")
      [[ -n $p ]] && kill "$p" 2>/dev/null
    fi
  done < <(live_children)
}

terminating=0
cleanup() { kill_children; rm -f "$dir/oc.pid"; }
on_signal() { terminating=1; kill_children; [[ -n ${cur_pid:-} ]] && kill "$cur_pid" 2>/dev/null; }
trap on_signal TERM INT
trap cleanup EXIT

ro_line=""
(( readonly )) && ro_line="- Do not edit any files. This is a read-only task."

child_rules=""
if (( depth + 1 < max_depth )); then
  child_rules=$(cat <<EOF

Child runs:
- Start child runs only when the work splits into independent parts with separate files and parallel work makes the task clearly faster. Otherwise do the work yourself.
- Start each child with 'oc -n <name> "<task>" &', then 'wait'. Children can start their own children under the same rule.
- Give each child an identity, its exact owned files, steps and checks. Children must not edit the same files.
- Read each child report. Fix or redo failed parts yourself.
- If a child exits 5, stop and report usage-limit.
- Add a line 'CHILDREN: <run names>' to your report.
EOF
)
  (( readonly )) && child_rules+=$'\n- This task is read-only. Start every child with -r.'
fi

if [[ -z "$session" ]]; then
  prompt="You are the executor. A reviewer plans the work and checks your result.
Rules:
- Do the task exactly as written. Do not expand scope.
- Do not commit, push, or open PRs unless the task says so.
- If the task is unclear or blocked, stop and say why. Do not guess.
- Run the checks that the task names, or the nearest relevant tests.
$ro_line
$child_rules

TASK:
$task

End with this report and nothing after it. Keep it short:
STATUS: done | blocked | failed
CHANGED: <files changed, or none>
CHECKS: <command -> pass/fail, one per line>
RESULT: <the answer or a summary, at most 15 lines>
QUESTIONS: <open points for the reviewer, or none>"
else
  prompt="REVIEW FEEDBACK. Fix these points, then send the same report format again:
$task"
fi
printf '%s\n' "$prompt" > "$dir/prompt.txt"

tree_sig() { git status --porcelain 2>/dev/null | md5sum | cut -c1-12; }

run_once() {
  local m=$1
  : > "$dir/events.jsonl"
  local args=(run -m "$m" --format json "${files[@]}" "${worktree[@]}")
  if [[ -n "$session" ]]; then args+=(-s "$session"); else args+=(--archived --title "oc:$name"); fi
  OC_PARENT="$run" OC_DEPTH=$(( depth + 1 )) OC_READONLY="$readonly" \
    opencode "${args[@]}" "$prompt" >> "$dir/events.jsonl" 2> "$dir/stderr.log" &
  local pid=$!
  cur_pid=$pid
  echo "$pid" > "$dir/pid"

  local start now last_act sig new_sig svc_m new_svc_m size new_size kids
  start=$(date +%s); last_act=$start
  sig=$(tree_sig); svc_m=$(stat -c %Y "$OC_SVC_LOG" 2>/dev/null || echo 0); size=0
  status_hint=""
  while kill -0 "$pid" 2>/dev/null && (( terminating == 0 )); do
    sleep 10 & wait $! 2>/dev/null
    (( terminating )) && break
    now=$(date +%s)
    new_size=$(stat -c %s "$dir/events.jsonl")
    new_sig=$(tree_sig)
    new_svc_m=$(stat -c %Y "$OC_SVC_LOG" 2>/dev/null || echo 0)
    if [[ $new_size != "$size" || $new_sig != "$sig" || $new_svc_m != "$svc_m" ]]; then
      last_act=$now; size=$new_size; sig=$new_sig; svc_m=$new_svc_m
    fi
    kids=$(count_live_children "$run")
    if (( kids > 0 )); then last_act=$now; fi
    if child_usage_limit; then status_hint=usage-limit; break; fi
    if (( now - last_act >= idle_limit )); then status_hint=hung; break; fi
    if (( now - start >= hard_limit )); then status_hint=timeout; break; fi
    if (( checkpoint > 0 && kids == 0 && now - start >= checkpoint )); then status_hint=slow; break; fi
  done
  if [[ -n $status_hint || $terminating == 1 ]]; then
    kill "$pid" 2>/dev/null; sleep 2; kill -9 "$pid" 2>/dev/null
  fi
  wait "$pid" 2>/dev/null
  rm -f "$dir/pid"
}

t0=$(date +%s)
used_model=$model
run_once "$model"
if [[ -z $status_hint ]] && (( terminating == 0 )) && hit_usage_limit "$dir/events.jsonl" \
   && [[ $model != "$OC_FALLBACK" && -n $OC_FALLBACK ]]; then
  limit_note="$model hit the OpenCode Go usage limit; this run used $OC_FALLBACK."
  used_model=$OC_FALLBACK
  jq --arg model "$OC_FALLBACK" '.model = $model' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
  run_once "$OC_FALLBACK"
fi

sid=$(jq -r 'select(.sessionID != null and .sessionID != "") | .sessionID' "$dir/events.jsonl" 2>/dev/null | head -1)
final=$(jq -rs '[.[] | select(.type=="text") | .part.text] | last // ""' "$dir/events.jsonl" 2>/dev/null)
err=$(jq -r 'select(.type=="error") | .error.message' "$dir/events.jsonl" 2>/dev/null | tail -1)
tools=$(jq -r 'select(.type=="tool_use") | .part.tool' "$dir/events.jsonl" 2>/dev/null | sort | uniq -c | awk '{printf "%s×%s ", $2, $1}')

if [[ $terminating == 1 ]]; then state=failed
elif [[ -n $status_hint ]]; then state=$status_hint
elif hit_usage_limit "$dir/events.jsonl"; then state=usage-limit
elif [[ -n $err ]]; then state=failed
else state=$(grep -oP '^STATUS:\s*\K\w+' <<<"$final" | tail -1); state=${state:-done}
fi

{
  echo "OC RUN $run"
  echo "state=$state model=$used_model time=$(( $(date +%s) - t0 ))s session=${sid:-none}"
  [[ -n ${limit_note:-} ]] && echo "note: $limit_note"
  [[ $terminating == 1 ]] && echo "note: stopped by signal"
  [[ -n $tools ]] && echo "tools: $tools"
  [[ -n $err ]] && echo "error: $err"
  if git rev-parse --git-dir >/dev/null 2>&1 && [[ ${#worktree[@]} -eq 0 ]]; then
    stat_out=$(git status --short 2>/dev/null | head -30)
    [[ -n $stat_out ]] && { echo "worktree:"; echo "$stat_out"; }
  fi
  echo "---"
  if [[ -n $final ]]; then
    lines=$(wc -l <<<"$final")
    if (( lines > REPORT_LINES )); then
      echo "[first $REPORT_LINES of $lines lines; full: oc log $run]"
      head -n "$REPORT_LINES" <<<"$final"
    else
      echo "$final"
    fi
  else
    echo "(no final text)"
  fi
  echo "---"
  [[ -n $sid ]] && echo "revise: oc -s $sid \"<feedback>\""
  [[ $state == slow && -n $sid ]] && echo "resume: oc -s $sid \"Continue. Hint: <orchestrator hint>\""
  echo "events: $dir/events.jsonl"
} > "$dir/report.md"


printf '%s\n' "$final" > "$dir/final.txt"
if (( quiet )); then
  echo "OC RUN $run state=$state report=$dir/report.md"
else
  cat "$dir/report.md"
fi

case $state in
  done) rc=0 ;; blocked) rc=2 ;; hung) rc=3 ;; timeout) rc=4 ;; usage-limit) rc=5 ;; slow) rc=6 ;; *) rc=1 ;;
esac
ended=$(date +%s)
jq -n --arg state "$state" --arg model "$used_model" --arg session "${sid:-}" --argjson ended "$ended" --argjson seconds "$(( ended - t0 ))" --argjson exit "$rc" '{state:$state, model:$model, session:$session, ended:$ended, seconds:$seconds, exit:$exit}' > "$dir/result.json"
exit "$rc"
}
